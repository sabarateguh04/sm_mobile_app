    "/api/cad/my-task": {
      "get": {
        "tags": [
          "Mobile CAD (Dispatcher)"
        ],
        "summary": "Daftar Tugas Petugas",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sukses"
          }
        }
      }
    },
    "/api/cad/terima-task": {
      "post": {
        "tags": [
          "Mobile CAD (Dispatcher)"
        ],
        "summary": "Terima Tugas",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "integer"
                  },
                  "userId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status Diubah"
          }
        }
      }
    },
    "/api/cad/menuju": {
