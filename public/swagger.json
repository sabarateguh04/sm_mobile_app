        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Limit data per halaman",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Nomor halaman",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data berhasil ditarik"
          }
        }
      }
    },
