{
  "openapi": "3.0.0",
  "info": {
    "title": "Smart Backoffice API",
    "description": "API Documentation untuk integrasi Mobile (Flutter) dan Sistem Web Pihak Ketiga.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sm.djalu.co.id",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login User",
        "description": "Mendapatkan JWT Bearer Token untuk mengakses endpoint lain.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "operator"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil Login"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/integration/wilayah": {
      "get": {
        "tags": [
          "Data Integration"
        ],
        "summary": "Tarik Data Master Wilayah",
        "description": "Mengambil data master wilayah/polres.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Limit data per halaman",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Nomor halaman",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data berhasil ditarik"
          }
        }
      }
    },
    "/api/integration/daerah": {
      "get": {
        "tags": [
          "Data Integration"
        ],
        "summary": "Tarik Data Master Daerah",
