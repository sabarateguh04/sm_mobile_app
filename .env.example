APP_NAME="Smart Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: set to true so the session cookie is marked Secure (required with many browsers / proxies).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Registrasi mandiri: pending = akun menunggu admin (tidak bisa login sampai diaktifkan). active = langsung login.
# REGISTRATION_ENABLED=true
# REGISTRATION_DEFAULT_ROLE_ID=3
# REGISTRATION_ACCOUNT_STATUS=pending

# Akun demo teritori (MasterTerritoryDemoAccountsSeeder): per_province = 1 kab/kota pertama tiap provinsi; all_kabkot = SETIAP kab/kota (banyak baris).
# MASTER_DEMO_TERRITORY_SCOPE=per_province
# Role yang di-seed per pasangan provinsi–kab: 2=admin, 3=oprator, 5=eks daerah, 6=eks resort
# MASTER_DEMO_MATRIX_ROLES=2,3,5,6
# Buat ulang akun + Excel per role: php artisan demo:rebuild-territory-demo --scope=all_kabkot --roles=2,3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SatuPeta (konversi dari satupeta_new / CodeIgniter) ---
# WAJIB: URL API backend (sama seperti URL_BE di CI satupeta_new/.env)
URL_BE=https://your-backend-api.example.com/api/v.0.1/
URL_SM=
URL_PETA=https://103.114.110.67/
# URL peta HARUS mengarah ke server Laravel ini (bukan CI lama)
API_KEY_GOOGLE=
# Peta: openstreetmap (default, gratis) | google (butuh API_KEY_GOOGLE aktif)
SATUPETA_MAP_PROVIDER=openstreetmap
LAT_CENTER=-6.200000
LNG_CENTER=106.816666
ZOOM_PETA=12
SBEARER=
# Database satupeta (sama DB_DATABASE=sbo di CI)
SATUPETA_DB_DATABASE=sbo
SATUPETA_INTAN_DB_DATABASE=intan
SATUPETA_SM_DB_DATABASE=db_sm_integration
# SST CCTV analytics (Api_sst)
SST_URL=http://36.66.191.180:3000/
SST_USERNAME=admin
SST_PASSWORD=admin12345
# Dev only — bypass SSO seperti CI DEV_BYPASS_AUTH
DEV_BYPASS_AUTH=false
POLDA_ID=1
POLRES_ID=1
